---
const target = '/en/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Universal AI Capability Platform</title>
    <meta name="description" content="Provider-neutral AI capability registry: discover, evaluate, route and execute AI tools across Hugging Face, MCP, OpenAPI and A2A." />
    <link rel="canonical" href={`${Astro.site}en/`} />
    <link rel="alternate" hreflang="en" href={`${Astro.site}en/`} />
    <link rel="alternate" hreflang="ru" href={`${Astro.site}ru/`} />
    <link rel="alternate" hreflang="zh-CN" href={`${Astro.site}zh-cn/`} />
    <link rel="alternate" hreflang="es" href={`${Astro.site}es/`} />
    <link rel="alternate" hreflang="de" href={`${Astro.site}de/`} />
    <link rel="alternate" hreflang="x-default" href={`${Astro.site}en/`} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
  <body>
    <p>Redirecting to <a href={target}>English</a>.</p>
  </body>
</html>
