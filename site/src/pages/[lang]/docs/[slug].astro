---
import { marked } from 'marked';
import BaseLayout from '../../../components/BaseLayout.astro';
import { META, type Lang } from '../../../data/i18n';

export function getStaticPaths() {
  const files = import.meta.glob('../../../content/topics/*.md', {
    query: '?raw',
    import: 'default',
    eager: true,
  }) as Record<string, string>;
  return (['en', 'ru'] as Lang[]).flatMap((lang) =>
    Object.entries(files).map(([path, content]) => {
      const slug = path.split('/').pop()!.replace(/\.md$/, '');
      return { params: { lang, slug }, props: { content, slug, lang } };
    }),
  );
}

const { content, slug, lang } = Astro.props as { content: string; slug: string; lang: Lang };
const html = marked.parse(content) as string;
const firstHeading = content.match(/^#\s+(.+)$/m)?.[1] ?? slug;
const canonical = `${Astro.site}${lang}/docs/${slug}/`;
const alternates: Record<string, string> = {
  en: `${Astro.site}en/docs/${slug}/`,
  ru: `${Astro.site}ru/docs/${slug}/`,
  'x-default': `${Astro.site}en/docs/${slug}/`,
};
---

<BaseLayout lang={lang} title={`${firstHeading} — Universal AI Capability Platform`} canonical={canonical} alternates={alternates}>
  <p><a href={`/${lang}/docs/`}>← Documentation topics</a></p>
  <article set:html={html} />
</BaseLayout>
